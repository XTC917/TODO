root ::= ws "{" ws "\"title\"" ws ":" ws string ws "," ws "\"date\"" ws ":" ws (datestr | "null") ws "," ws "\"startTime\"" ws ":" ws (timestr | "null") ws "," ws "\"endTime\"" ws ":" ws (timestr | "null") ws "," ws "\"taskType\"" ws ":" ws tasktype ws "," ws "\"todoTimeMode\"" ws ":" ws timemode ws "," ws "\"reminderOffsetsSeconds\"" ws ":" ws reminders ws "," ws "\"note\"" ws ":" ws (string | "null") ws "}" ws

ws ::= [ \t\n]*
string ::= "\"" schar* "\""
schar ::= [^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
datestr ::= "\"" [0-9] [0-9] [0-9] [0-9] "-" [0-9] [0-9] "-" [0-9] [0-9] "\""
timestr ::= "\"" [0-9] [0-9] ":" [0-9] [0-9] "\""
tasktype ::= "\"schedule\"" | "\"todo\""
timemode ::= "\"timeBlock\"" | "\"deadline\"" | "\"noTime\""
reminders ::= "[" ws (number (ws "," ws number)*)? ws "]"
number ::= ([0-9] | [1-9] [0-9] | [1-9] [0-9] [0-9] | [1-9] [0-9] [0-9] [0-9] | [1-9] [0-9] [0-9] [0-9] [0-9] | [1-6] [0-9] [0-9] [0-9] [0-9] [0-9])
