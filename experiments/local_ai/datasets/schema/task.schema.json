{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "date",
    "startTime",
    "endTime",
    "taskType",
    "todoTimeMode",
    "reminderOffsetsSeconds",
    "note"
  ],
  "properties": {
    "title": { "type": "string", "maxLength": 60 },
    "date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "startTime": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}:[0-9]{2}$"
    },
    "endTime": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}:[0-9]{2}$"
    },
    "taskType": { "type": "string", "enum": ["schedule", "todo"] },
    "todoTimeMode": {
      "type": "string",
      "enum": ["timeBlock", "deadline", "noTime"]
    },
    "reminderOffsetsSeconds": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "integer", "minimum": 0, "maximum": 604800 }
    },
    "note": { "type": ["string", "null"], "maxLength": 120 }
  }
}
